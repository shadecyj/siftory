# Real PostgreSQL connection used by npm run db:migrate
DATABASE_URL=
# Leave DATABASE_URL empty to use the durable local PostgreSQL-compatible store.
SEARCHOS_PGLITE_DATA_DIR=.searchos/runtime-db

# Runtime. Replay is deterministic and needs no provider keys.
SEARCHOS_RUNTIME_MODE=replay
# Tavily free tier requires no credit card; Brave remains supported.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# Live mode requires an explicit provider plus that provider's key and model.
# Source-run Web uses this local file only. The Windows desktop installer uses
# its native Credentials panel and never writes keys to this file.
MODEL_PROVIDER=deepseek
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SEARCHOS_FETCH_USER_AGENT=Siftory/0.1
LIVE_SMOKE_QUERY=Python 怎么删除 dict key？
