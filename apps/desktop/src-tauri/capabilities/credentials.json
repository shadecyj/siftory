{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "credentials-capability",
  "description": "Only the bundled credentials window may write, test, apply, clear, or inspect redacted Live profile status.",
  "windows": ["credentials"],
  "platforms": ["windows"],
  "permissions": [
    "core:default",
    "allow-get-live-profile-status",
    "allow-save-live-profile",
    "allow-test-live-profile",
    "allow-activate-live-profile",
    "allow-clear-live-profile"
  ]
}
