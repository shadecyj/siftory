{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Siftory",
  "version": "0.1.0",
  "identifier": "com.searchos.desktop",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "loopback-workspace-capability",
        "credentials-capability"
      ]
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Evidence-first personal search workspace",
    "longDescription": "Siftory turns web search into evidence-linked, confidence-aware personal knowledge.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/runtime/": "runtime/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
