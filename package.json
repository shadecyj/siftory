{
  "name": "siftory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @searchos/web",
    "build": "npm run typecheck && npm run build --workspace @searchos/web",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run db:smoke && npm run smoke && npm run smoke:durable",
    "db:generate": "drizzle-kit generate --config packages/persistence/drizzle.config.ts",
    "db:migrate": "tsx packages/persistence/scripts/migrate.ts",
    "db:smoke": "vitest run packages/persistence/test/migration.test.ts",
    "smoke": "node ./scripts/e2e-smoke.mjs",
    "smoke:durable": "node ./scripts/durable-smoke.mjs",
    "smoke:live": "node ./scripts/live-smoke.mjs",
    "smoke:live:matrix": "node ./scripts/live-matrix.mjs",
    "smoke:live:acceptance": "node ./scripts/live-acceptance.mjs",
    "demo:replay": "node ./scripts/demo-server.mjs replay",
    "demo:live": "node ./scripts/demo-server.mjs live",
    "demo:reset": "node ./scripts/demo-reset.mjs",
    "desktop:prepare": "npm run build && node ./scripts/prepare-tauri-runtime.mjs",
    "desktop:dev": "npm run desktop:prepare && tauri dev --config ./apps/desktop/src-tauri/tauri.conf.json",
    "desktop:build": "npm run desktop:prepare && tauri build --config ./apps/desktop/src-tauri/tauri.conf.json && node ./scripts/collect-desktop-release.mjs && node ./scripts/release-security-scan.mjs",
    "desktop:smoke:credential-store": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml windows_credential_manager_smoke -- --ignored",
    "security:scan:release": "node ./scripts/release-security-scan.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.1",
    "globals": "^17.11.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
